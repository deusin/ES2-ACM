<?xml version="1.0" encoding="utf-8" ?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../Schemas/GameSettingDefinition.xsd">
  <!-- ACM New Game toggles. Each one also needs: an Entry in the AdvancedSettingsACMSettings group of
       GUI/Screens/GUIElements[NewGameScreen].xml, GuiElements Setting<Name>/<Name>True/<Name>False in
       GUI/GUIElements[ACM_Settings].xml and %Setting<Name>... strings in Localization. Gate content with
       <GameSettingPrerequisite Flags="Prerequisite,Discard"><Name>,True</GameSettingPrerequisite> on
       definition types whose schema accepts it (Public/Schemas). -->

  <GameSettingDefinition Name="EnableSamus" Type="bool" Default="True">
    <ItemDefinition Name="False"/>
    <ItemDefinition Name="True"/>
  </GameSettingDefinition>

  <GameSettingDefinition Name="EnableArkonPortal" Type="bool" Default="True">
    <ItemDefinition Name="False"/>
    <ItemDefinition Name="True"/>
  </GameSettingDefinition>

  <GameSettingDefinition Name="EnableWorthyDeeds" Type="bool" Default="True">
    <ItemDefinition Name="False"/>
    <ItemDefinition Name="True"/>
  </GameSettingDefinition>

</Datatable>
