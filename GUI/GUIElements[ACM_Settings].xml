<?xml version="1.0" encoding="utf-8" ?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../Schemas/Amplitude.Unity.Gui.GuiElement.xsd">
  <!-- ACM Settings group of the New Game advanced settings (see Settings/GameSettingDefinitions[ACM].xml) -->
  <GuiElement Name="AdvancedSettingsACMSettings">
    <Title>%AdvancedSettingsACMTitle</Title>
    <Icons>
      <Icon Size="Large" Path="Bitmaps/Dynamic/Settings/SettingsGameplayNarrationLarge"/>
    </Icons>
  </GuiElement>

  <!-- Enable Samus Aran -->
  <GuiElement Name="SettingEnableSamus">
    <Title>%SettingEnableSamusTitle</Title>
    <Description>%SettingEnableSamusDescription</Description>
  </GuiElement>

  <GuiElement Name="SettingEnableSamusTrue">
    <Title>%SettingEnableSamusTrueTitle</Title>
    <Description>%SettingEnableSamusTrueDescription</Description>
  </GuiElement>

  <GuiElement Name="SettingEnableSamusFalse">
    <Title>%SettingEnableSamusFalseTitle</Title>
    <Description>%SettingEnableSamusFalseDescription</Description>
  </GuiElement>

  <!-- Enable Arkon Portal -->
  <GuiElement Name="SettingEnableArkonPortal">
    <Title>%SettingEnableArkonPortalTitle</Title>
    <Description>%SettingEnableArkonPortalDescription</Description>
  </GuiElement>

  <GuiElement Name="SettingEnableArkonPortalTrue">
    <Title>%SettingEnableArkonPortalTrueTitle</Title>
    <Description>%SettingEnableArkonPortalTrueDescription</Description>
  </GuiElement>

  <GuiElement Name="SettingEnableArkonPortalFalse">
    <Title>%SettingEnableArkonPortalFalseTitle</Title>
    <Description>%SettingEnableArkonPortalFalseDescription</Description>
  </GuiElement>

  <!-- Enable Worthy Deeds -->
  <GuiElement Name="SettingEnableWorthyDeeds">
    <Title>%SettingEnableWorthyDeedsTitle</Title>
    <Description>%SettingEnableWorthyDeedsDescription</Description>
  </GuiElement>

  <GuiElement Name="SettingEnableWorthyDeedsTrue">
    <Title>%SettingEnableWorthyDeedsTrueTitle</Title>
    <Description>%SettingEnableWorthyDeedsTrueDescription</Description>
  </GuiElement>

  <GuiElement Name="SettingEnableWorthyDeedsFalse">
    <Title>%SettingEnableWorthyDeedsFalseTitle</Title>
    <Description>%SettingEnableWorthyDeedsFalseDescription</Description>
  </GuiElement>

  <!-- Enable Kaizen Rejuvenation -->
  <GuiElement Name="SettingEnableKaizenRejuvenation">
    <Title>%SettingEnableKaizenRejuvenationTitle</Title>
    <Description>%SettingEnableKaizenRejuvenationDescription</Description>
  </GuiElement>

  <GuiElement Name="SettingEnableKaizenRejuvenationTrue">
    <Title>%SettingEnableKaizenRejuvenationTrueTitle</Title>
    <Description>%SettingEnableKaizenRejuvenationTrueDescription</Description>
  </GuiElement>

  <GuiElement Name="SettingEnableKaizenRejuvenationFalse">
    <Title>%SettingEnableKaizenRejuvenationFalseTitle</Title>
    <Description>%SettingEnableKaizenRejuvenationFalseDescription</Description>
  </GuiElement>
</Datatable>
