<?xml version="1.0" encoding="utf-8" ?>
<Datatable xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xsi:noNamespaceSchemaLocation="../Schemas/Amplitude.Unity.Gui.GuiElement.xsd">
  <!-- ACM Settings group of the New Game advanced settings (see Settings/GameSettingDefinitions[ACM].xml) -->
  <GuiElement Name="AdvancedSettingsACMSettings">
    <Title>%AdvancedSettingsACMTitle</Title>
    <Icons>
      <Icon Size="Large" Path="Bitmaps/Dynamic/Settings/SettingsGameplayNarrationLarge"/>
    </Icons>
  </GuiElement>

  <!-- Enable Samus Aran -->
  <GuiElement Name="SettingEnableSamus">
    <Title>%SettingEnableSamusTitle</Title>
    <Description>%SettingEnableSamusDescription</Description>
  </GuiElement>

  <GuiElement Name="SettingEnableSamusTrue">
    <Title>%SettingEnableSamusTrueTitle</Title>
    <Description>%SettingEnableSamusTrueDescription</Description>
  </GuiElement>

  <GuiElement Name="SettingEnableSamusFalse">
    <Title>%SettingEnableSamusFalseTitle</Title>
    <Description>%SettingEnableSamusFalseDescription</Description>
  </GuiElement>
</Datatable>
