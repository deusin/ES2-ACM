        <Steps>
        <!--============ Step 1 ============-->
        <Step Name="Step1">
            <ObjectiveSet>

            <!--Teams are created here that's why the following variable must be set here. And the context here is the team
            <Vars>
                <Var VarName="$CurrentEmpire">
                <From Source="$Team"/>
                </Var>
            </Vars>-->

            <Objective Name="Deeds_Regular_EmpireDevelopment_Stage4_B-Objective" StartValue="0" EndValue="$SystemObjective">
                <Parallel CompletionPolicy="All">

                <Loop>
                    <Decorator_SystemGainedFromInfluence Initiator="Empire" ProgressionIncrement="1">
