    <QuestDefinition Name="Deeds_Wonder1" Category="Deeds" SubCategory="Regular">
        
        <!--============ TAGS ============-->
        <Tags>BeginTurn,Hidden,TechnologyStageDefinitionEmpireDevelopment2</Tags>

        <!--============ CONTEXT ============-->
        <!--<QuestContextMulti>
            <Distribution Type="FreeForAll"/>
        </QuestContextMulti>-->
        <QuestContextSolo/>

        <!--============ OCCURRENCE RULES ============-->
        <!--<RepetitionRules  NumberOfOccurrencesPerGame="1"/>-->
        <RepetitionRules  NumberOfOccurrencesPerGame="0"
                          NumberOfOccurrencesPerEmpire="1"
                          NumberOfConcurrentInstances="0"/>
        
        <!--============ VARIABLES ============-->
        <Vars>
            <Var VarName="$CurrentEmpire">
                <From Source="$Empire"/>
            </Var>

            <Var VarName="$AllEmpires">
                <From Source="$Empires"/>
            </Var>

            <Var VarName="$BuiltSystemImprovementObjective" IntValue="1"/>
            <Var VarName="$Expression" StringValue="Count(Context, @'EmpireTypeMajor/ClassColonizedStarSystem/StarSystemImprovementWonder1')"/>
            
            <LocalizationVar LocalizationKey="$ImprovementAmount" Source="$BuiltSystemImprovementObjective"/>
            
            <Var VarName="$Path" StringValue="EmpireTypeMajor/ClassResearch,TechnologyStageEmpireDevelopment2"/>

        </Vars>

        <!--============ PREREQUISITES ============-->
        

        <!--============ STEPS ============-->
        <Steps>
            <!--============ Step 1 ============-->
            <Step Name="Step1">
                <ObjectiveSet>
                    
                    <!--Teams are created here that's why the following variable must be set here
                    <Vars>
                        <Var VarName="$CurrentEmpire">
                            <From Source="$Team"/>
                        </Var>
                    </Vars>-->
                    
                    <Objective Name="Step1_Objective1" StartValue="0" EndValue="$BuiltSystemImprovementObjective">
                        <Parallel CompletionPolicy="All">
                            
                            <Sequence>
                                <Decorator_BeginTurn>
                                    <Condition_IsProgressionComplete>
                                        <Input_Context VarName="$CurrentEmpire"/>
                                        <Input_EmpireWhoseProgressToUpdate VarName="$CurrentEmpire"/>
                                        <Input_Expression VarName="$Expression"/>
                                    </Condition_IsProgressionComplete>
                                </Decorator_BeginTurn>
                            </Sequence>

                            <Sequence>
                                <Decorator_BeginTurn>
                                    <Condition_CheckPath>
                                        <Input_SimulationObject VarName="$CurrentEmpire"/>
                                        <Input_Path VarName="$Path"/>
                                    </Condition_CheckPath>
                                </Decorator_BeginTurn>
                            </Sequence>

                        </Parallel>
                    </Objective>
                    <Reward Droplist="DroplistRegularDeedsStage4Quadrant4Bis3" Picks="1"/>
                    <!--<Reward Droplist="DroplistRegularDeedsWonder1Alt" Picks="1"/>-->                                                                                                                                                                                           
                </ObjectiveSet>
            </Step>
        </Steps>

    </QuestDefinition>


    <QuestDefinition Name="Deeds_Regular_EmpireDevelopment_Stage4_A" Category="Deeds" SubCategory="Regular">
        
