                    </Condition_CheckPath>
                    </Decorator_BeginTurn>
                </Sequence>

                </Parallel>
            </Objective>
            <Reward Droplist="DroplistRegularDeedsStage4Quadrant4Bis" Picks="1"/>
            <Reward Droplist="DroplistRegularDeedsStage4Quadrant4Bis2" Picks="1"/>
            
            </ObjectiveSet>
        </Step>
        </Steps>

    </QuestDefinition>

    

