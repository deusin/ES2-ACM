                          NumberOfOccurrencesPerEmpire="1"
                          NumberOfConcurrentInstances="0"/>
        
        <!--============ VARIABLES ============-->
        <Vars>
            <Var VarName="$CurrentEmpire">
                <From Source="$Empire"/>
            </Var>

            <Var VarName="$AllEmpires">
                <From Source="$Empires"/>
            </Var>

            <Var VarName="$Amount01" IntValue="14"/>
            <Var VarName="$Expression01" StringValue="SumProperty(Context, @'ClassEmpire/ClassColonizedStarSystem/ClassColonizedPlanet', AnomalyCount)"/>

            <LocalizationVar LocalizationKey="$Amount01Name" Source="$Amount01"/>

            <Var VarName="$Path" StringValue="EmpireTypeMajor/ClassResearch,TechnologyStageScienceAndExploration5"/>

        </Vars>

        <!--============ PREREQUISITES ============-->
        <Prerequisites Target="$(Empire)">

            <QuestStatePrerequisite Flags="Prerequisite" Inverted="true" QuestDefinitionName="Deeds_Regular_ScienceAndExploration_Stage5_A" QuestState="InProgress"/>
            <QuestStatePrerequisite Flags="Prerequisite" Inverted="true" QuestDefinitionName="Deeds_Regular_ScienceAndExploration_Stage5_A" QuestState="Completed"/>

            <QuestStatePrerequisite Flags="Prerequisite" QuestDefinitionName="Deeds_Regular_ScienceAndExploration_Stage5_A" QuestState="NotStarted"/>
            <QuestStatePrerequisite Flags="Prerequisite" QuestDefinitionName="Deeds_Regular_ScienceAndExploration_Stage5_B" QuestState="NotStarted"/>

            <QuestStatePrerequisite Flags="Prerequisite" Inverted="true" QuestDefinitionName="Deeds_Regular_ScienceAndExploration_Stage5_B" QuestState="InProgress"/>
            <QuestStatePrerequisite Flags="Prerequisite" Inverted="true" QuestDefinitionName="Deeds_Regular_ScienceAndExploration_Stage5_B" QuestState="Completed"/>
            <DownloadableContentPrerequisite Flags="Prerequisite,Discard">DLCVaulters</DownloadableContentPrerequisite>
        </Prerequisites>

        <!--============ STEPS ============-->
        <Steps>
            <!--============ Step 1 ============-->
            <Step Name="Step1">
                <ObjectiveSet>

                    <!--Teams are created here, that's why setting the empire in a variable can only be made from here
                    <Vars>
                        <Var VarName="$CurrentEmpire">
                            <From Source="$Team"/>
                        </Var>
                    </Vars>-->

                    <Objective Name="Deeds_Regular_ScienceAndExploration_Stage5_C-Objective" StartValue="0" EndValue="$Amount01">
                        <Parallel CompletionPolicy="All">

                            <Sequence>
                                <Decorator_BeginTurn>
                                    <Condition_IsProgressionComplete>
                                        <Input_Context VarName="$CurrentEmpire"/>
                                        <Input_EmpireWhoseProgressToUpdate VarName="$CurrentEmpire"/>
                                        <Input_Expression VarName="$Expression01"/>
                                    </Condition_IsProgressionComplete>
                                </Decorator_BeginTurn>
                            </Sequence>

                            <Sequence>
                                <Decorator_BeginTurn>
                                    <Condition_CheckPath>
                                        <Input_SimulationObject VarName="$CurrentEmpire"/>
                                        <Input_Path VarName="$Path"/>
                                    </Condition_CheckPath>
                                </Decorator_BeginTurn>
                            </Sequence>

                        </Parallel>
                    </Objective>
                    <Reward Droplist="DroplistRegularDeedsStage5Quadrant3Bis" Picks="1"/>
                    
                    <Reward Droplist="DroplistRegularDeedsStage5Quadrant3Bis2" Picks="1"/>
                </ObjectiveSet>
            </Step>
        </Steps>

    </QuestDefinition>
   
   

</Datatable>