    <QuestDefinition Name="Deeds_Regular_EconomyAndTrade_Stage2_A" Category="Deeds" SubCategory="Regular">
        
        <!--============ TAGS ============-->
        <Tags>BeginTurn,Hidden,TechnologyStageDefinitionEconomyAndTrade2</Tags>

        <!--============ CONTEXT ============-->
        <!--<QuestContextMulti>
            <Distribution Type="FreeForAll"/>
        </QuestContextMulti>-->
        <QuestContextSolo/>

        <!--============ OCCURRENCE RULES ============-->
        <!--<RepetitionRules  NumberOfOccurrencesPerGame="1"/>-->
        <RepetitionRules  NumberOfOccurrencesPerGame="0"
                          NumberOfOccurrencesPerEmpire="1"
                          NumberOfConcurrentInstances="0"/>
        
        <!--============ VARIABLES ============-->
        <Vars>
            <Var VarName="$CurrentEmpire">
                <From Source="$Empire"/>
            </Var>

            <Var VarName="$AllEmpires">
                <From Source="$Empires"/>
            </Var>

            <Var VarName="$UniqueStarSystemImprovementObjective" IntValue="3"/>
            <Var VarName="$Expression" StringValue="Count(Context, @'EmpireTypeMajor/ClassColonizedStarSystem/ClassImprovement,StarSystemImprovementOncePerEmpire')"/>
            
            <LocalizationVar LocalizationKey="$ImprovementAmount" Source="$UniqueStarSystemImprovementObjective"/>
            
            <Var VarName="$Path" StringValue="EmpireTypeMajor/ClassResearch,TechnologyStageEconomyAndTrade2"/>

        </Vars>

        <!--============ PREREQUISITES ============-->
        <Prerequisites Target="$(Empire)">
            <QuestStatePrerequisite Flags="Prerequisite" Inverted="true" QuestDefinitionName="Deeds_Regular_EconomyAndTrade_Stage2_B" QuestState="InProgress"/>
            <QuestStatePrerequisite Flags="Prerequisite" Inverted="true" QuestDefinitionName="Deeds_Regular_EconomyAndTrade_Stage2_B" QuestState="Completed"/>

            <QuestStatePrerequisite Flags="Prerequisite" QuestDefinitionName="Deeds_Regular_EconomyAndTrade_Stage2_B" QuestState="NotStarted"/>
            <QuestStatePrerequisite Flags="Prerequisite" QuestDefinitionName="Deeds_Regular_EconomyAndTrade_Stage2_C" QuestState="NotStarted"/>
            
            <QuestStatePrerequisite Flags="Prerequisite" Inverted="true" QuestDefinitionName="Deeds_Regular_EconomyAndTrade_Stage2_C" QuestState="InProgress"/>
            <QuestStatePrerequisite Flags="Prerequisite" Inverted="true" QuestDefinitionName="Deeds_Regular_EconomyAndTrade_Stage2_C" QuestState="Completed"/>
        </Prerequisites>

        <!--============ STEPS ============-->
        <Steps>
            <!--============ Step 1 ============-->
            <Step Name="Step1">
                <ObjectiveSet>
                    
                    <!--Teams are created here that's why the following variable must be set here
                    <Vars>
                        <Var VarName="$CurrentEmpire">
                            <From Source="$Team"/>
                        </Var>
                    </Vars>-->
                    
                    <Objective Name="Deeds_Regular_EconomyAndTrade_Stage2_A-Objective" StartValue="0" EndValue="$UniqueStarSystemImprovementObjective">
                        <Parallel CompletionPolicy="All">
                            
                            <Sequence>
                                <Decorator_BeginTurn>
                                    <Condition_IsProgressionComplete>
                                        <Input_Context VarName="$CurrentEmpire"/>
                                        <Input_EmpireWhoseProgressToUpdate VarName="$CurrentEmpire"/>
                                        <Input_Expression VarName="$Expression"/>
                                    </Condition_IsProgressionComplete>
                                </Decorator_BeginTurn>
                            </Sequence>

                            <Sequence>
                                <Decorator_BeginTurn>
                                    <Condition_CheckPath>
                                        <Input_SimulationObject VarName="$CurrentEmpire"/>
                                        <Input_Path VarName="$Path"/>
                                    </Condition_CheckPath>
                                </Decorator_BeginTurn>
                            </Sequence>

                        </Parallel>
                    </Objective>
                    <Reward Droplist="DroplistRegularDeedsStage2Quadrant2Bis" Picks="1"/>
                    <Reward Droplist="DroplistRegularDeedsStage2Quadrant2Bis2" Picks="1"/>
                    <Reward Droplist="DroplistRegularDeedsStage2Quadrant2Bis3" Picks="1"/>
                                                                                                                                                                                                                 
                </ObjectiveSet>
            </Step>
        </Steps>

    </QuestDefinition>


